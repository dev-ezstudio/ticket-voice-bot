# ===== Discord =====
# Bot Token จาก https://discord.com/developers/applications -> Bot -> Reset Token
TOKEN=your_discord_bot_token_here

# Application ID (Client ID) จากหน้า General Information
CLIENT_ID=your_discord_application_id_here

# (ไม่บังคับ) ใส่ Guild ID ถ้าต้องการลงทะเบียน slash command แบบเซิร์ฟเวอร์เดียว
# ข้อดี: อัปเดตทันที ไม่ต้องรอ Discord sync — เหมาะกับตอนพัฒนา
# ถ้าเว้นว่าง จะลงทะเบียนแบบ global (ใช้ได้ทุกเซิร์ฟเวอร์ แต่ sync ช้ากว่า)
GUILD_ID=

# ===== Supabase =====
# Project URL จาก Supabase Dashboard -> Project Settings -> Data API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# ต้องใช้ key ฝั่ง secret เพราะตารางเปิด RLS ไว้
# Supabase Dashboard -> Project Settings -> API Keys
#   โปรเจกต์ใหม่ : sb_secret_...   (ห้ามใช้ sb_publishable_...)
#   โปรเจกต์เดิม : service_role     (ห้ามใช้ anon)
# ⚠️ ห้ามเผยแพร่ key นี้ และห้าม commit ไฟล์ .env ขึ้น git
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ===== ไม่บังคับ: ใช้เฉพาะกับ npm run setup-db =====
# Connection string สำหรับให้สคริปต์ setup-db.js รัน schema.sql ขึ้น Supabase ให้อัตโนมัติ
# (ถ้าจะรัน schema.sql เองผ่าน Supabase SQL Editor ก็ไม่ต้องใส่ค่านี้)
#
# วิธีเอา: Supabase Dashboard -> ปุ่ม Connect ด้านบน -> แท็บ Connection string
#          -> เลือกแบบ Session pooler -> คัดลอก URI -> แทน [YOUR-PASSWORD] ด้วยรหัสจริง
# ⚠️ ถ้ารหัสมีอักขระพิเศษ (@ : / ? #) ต้อง URL-encode ก่อน เช่น @ -> %40
DATABASE_URL=

# ===== เว็บ Dashboard (npm run dashboard) =====
# Client Secret จาก Developer Portal -> OAuth2 -> Client Secret -> Reset Secret
# ⚠️ ห้ามเผยแพร่ ใช้แลก token ตอนล็อกอินได้
CLIENT_SECRET=

# พอร์ตที่ dashboard เปิด (ค่าเริ่มต้น 3000)
DASHBOARD_PORT=3210

# URL ที่เปิด dashboard — ต้องตรงกับ Redirect URI ใน Developer Portal
# ใช้ในเครื่อง: http://localhost:3210
# ถ้า deploy จริง: https://dashboard.example.com
DASHBOARD_URL=http://localhost:3210

# ข้อความสุ่มยาวๆ ใช้เซ็น session cookie (ไม่ตั้ง = สุ่มใหม่ทุกครั้งที่รีสตาร์ท)
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ปิดการล็อกอิน Discord (ใช้ตอนทดสอบในเครื่องตัวเอง)
#   off = ไม่ต้องล็อกอิน ใครเปิด URL ได้ก็เห็นข้อมูลทั้งหมด
#   เว้นว่าง/ค่าอื่น = ต้องล็อกอิน (ค่าเริ่มต้น ปลอดภัยกว่า)
# ⚠️ ห้ามตั้ง off ตอนเปิดออกอินเทอร์เน็ต
DASHBOARD_AUTH=
